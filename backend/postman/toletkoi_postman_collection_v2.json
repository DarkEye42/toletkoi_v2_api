    {
      "name": "Payments",
      "item": [
        {
          "name": "Init Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/init",
