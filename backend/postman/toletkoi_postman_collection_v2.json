            "body": {
              "mode": "raw",
              "raw": "{\n  \"uniqueId\": \"r-0007\",\n  \"post_owner\": 2,\n  \"description\": \"New rental\",\n  \"category\": \"rental\",\n  \"cost\": 12000\n}"
            }
          }
        },
        {
          "name": "Get Ad by Slug",
