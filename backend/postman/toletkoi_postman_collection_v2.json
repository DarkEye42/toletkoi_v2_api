    {
      "name": "Search",
      "item": [
        {
          "name": "Search Rentals, Hotels, Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/search?q=flat&priceMin=5000&priceMax=20000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search"],
              "query": [
                { "key": "q", "value": "flat" },
                { "key": "priceMin", "value": "5000" },
                { "key": "priceMax", "value": "20000" }
              ]
            }
          }
